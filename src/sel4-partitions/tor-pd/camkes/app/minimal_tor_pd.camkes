/*
 * minimal_tor_pd.camkes — Two Linux Guest VMs (vm0 + vm1) with IPC
 * v4: pcnet NIC (AMD Am79C970A, PCI 1022:2000) passed to vm1 via I/O ports.
 *     pcnet32 is an I/O-PORT-ONLY NIC: BAR0 is I/O ports (no MMIO needed),
 *     which seL4 can grant directly via ioport caps — no device untyped /
 *     EPT MMIO mapping required (the limitation that defeated the e1000,
 *     whose BAR0 was MMIO at 0xfeb80000). The guest kernel has
 *     CONFIG_PCNET32=y (built-in). QEMU: -device pcnet,netdev=net0.
 *     QEMU assigns: Bus 0, Dev 3, Fun 0, IRQ 11 pin A, BAR0 I/O 0xc000-0xc01f.
 *     PCI config-space passthrough is done entirely in C
 *     (cross_vm_connections_vm1.c) via vmm_pci_create_passthrough — NO
 *     camkes pci_devices block (which would require MMIO untypeds).
 */
import <VM/vm.camkes>;

#include <configurations/vm.h>

#define VM_GUEST_CMDLINE "earlyprintk=ttyS0,115200 console=ttyS0,115200 loglevel=7 rdinit=/init i8042.nokbd=iy \
i8042.nomux=y i8042.noaux=y io_delay=udelay noisapnp pci=nomsi realloc=off"
#define VM_GUEST_CMDLINE_QUIET "earlyprintk=ttyS0,115200 console=ttyS0,115200 loglevel=0 rdinit=/init i8042.nokbd=iy \
i8042.nomux=y i8042.noaux=y io_delay=udelay noisapnp pci=nomsi realloc=off"

component Init0 {
    dataport Buf(4096) tor_src_dp;
    dataport Buf(4096) tor_dest_dp;
    emits Ready tor_ready;
    consumes Done tor_done;
    has mutex cross_vm_event_mutex;
    VM_INIT_DEF()
}

component Init1 {
    dataport Buf(4096) tor_src_dp;
    dataport Buf(4096) tor_dest_dp;
    consumes Ready tor_ready;
    emits Done tor_done;
    has mutex cross_vm_event_mutex;
    VM_INIT_DEF()
}

assembly {
    composition {
        VM_COMPOSITION_DEF()
        VM_PER_VM_COMP_DEF(0)
        VM_PER_VM_COMP_DEF(1)

        connection seL4SharedDataWithCaps tor_conn_src(from vm0.tor_src_dp,
                                                        to vm1.tor_src_dp);
        connection seL4SharedDataWithCaps tor_conn_dest(from vm1.tor_dest_dp,
                                                         to vm0.tor_dest_dp);
        connection seL4Notification tor_ready_conn(from vm0.tor_ready,
                                                   to vm1.tor_ready);
        connection seL4Notification tor_done_conn(from vm1.tor_done,
                                                  to vm0.tor_done);
    }

    configuration {
        VM_CONFIGURATION_DEF()
        VM_PER_VM_CONFIG_DEF(0)
        vm0.simple_untyped23_pool = 40;
        vm0.simple_untyped22_pool = 1;
        vm0.heap_size = 0x10000;
        vm0.guest_ram_mb = 128;
        vm0.kernel_cmdline = VM_GUEST_CMDLINE_QUIET;
        vm0.kernel_image = "bzimage";
        vm0.kernel_relocs = "bzimage";
        vm0.initrd_image = "rootfs.cpio";
        vm0.tor_src_dp_id = 1;
        vm0.tor_src_dp_size = 4096;
        vm0.tor_dest_dp_id = 2;
        vm0.tor_dest_dp_size = 4096;
        vm0.iospace_domain = 0x0f;
        vm0.pci_devices_iospace = 1;

        VM_PER_VM_CONFIG_DEF(1)
        vm1.simple_untyped23_pool = 40;
        vm1.simple_untyped22_pool = 1;
        vm1.heap_size = 0x10000;
        vm1.guest_ram_mb = 256;
        vm1.kernel_cmdline = VM_GUEST_CMDLINE;
        vm1.kernel_image = "bzimage";
        vm1.kernel_relocs = "bzimage";
        vm1.initrd_image = "rootfs_vm1.cpio";
        vm1.tor_src_dp_id = 1;
        vm1.tor_src_dp_size = 4096;
        vm1.tor_dest_dp_id = 2;
        vm1.tor_dest_dp_size = 4096;
        vm1.iospace_domain = 0x10;
        vm1.pci_devices_iospace = 2;

        /* pcnet NIC I/O-port + IRQ passthrough to vm1 (C-only PCI config
         * passthrough; no camkes pci_devices block needed).
         * QEMU pcnet: BDF 0:3:0, IRQ 11 pin A, BAR0 I/O 0xc000-0xc01f (0x20).
         * The ioport range is granted as a NON-PCI ioport (no pci_device
         * field) so the VMM registers it via vm_enable_passthrough_ioport
         * (main.c nonpci ioport loop). The pcnet32 driver probes BAR0, sees
         * bit0=1 (I/O port space), and accesses 0xc000-0xc01f directly.
         * IRQ 11 is injected via vm_irqs (registered independently in
         * init_irqs). end=0xc020 covers 0xc000-0xc01f under both
         * inclusive/exclusive ioport-cap interpretations.
         *
         * NOTE: PCI config ports 0xCF8-0xCFF are NOT added here — they are
         * already owned by the seL4 VM framework's `pci_config` CAmkES
         * component (pci_config.config_address_ports_ioport=[0xCF8..0xCFB]
         * and pci_config.config_data_ports_ioport=[0xCFC..0xCFF]). Adding
         * them to vm1.vm_ioports causes a capdl "ports already in use"
         * conflict at boot. The VMM's vm_io_port_add_handler for 0xCF8-0xCFF
         * in main.c is the correct interception mechanism and does NOT need
         * guest ioport caps. */
        vm1.vm_ioports = [
            {"start":0xc000, "end":0xc020, "name":"pcnet0"},
        ];
        vm1.vm_irqs = [
            {"name":"pcnet0", "ioapic":0, "source":11, "level_trig":1, "active_low":0, "dest":11},
        ];
    }
}
