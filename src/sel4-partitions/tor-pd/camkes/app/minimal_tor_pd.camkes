/*
 * minimal_tor_pd.camkes — Two Linux Guest VMs (vm0 + vm1) with IPC
 * Based on the proven x86 multi-VM pattern from optiplex9020.camkes.
 * v3: e1000 NIC passed to vm1 via I/O PORTS only (BAR1: 0xc000-0xc040).
 *     MMIO BARs and untyped_mmios removed — seL4 has no device untyped
 *     for the PCI MMIO hole (0xfeb80000+) so we rely on the e1000 driver's
 *     I/O port access path. QEMU: -device e1000,netdev=net0.
 */
import <VM/vm.camkes>;

#include <configurations/vm.h>

#define VM_GUEST_CMDLINE "earlyprintk=ttyS0,115200 console=ttyS0,115200 rdinit=/init i8042.nokbd=iy \
i8042.nomux=y i8042.noaux=y io_delay=udelay noisapnp pci=nomsi realloc=off"

component Init0 {
    dataport Buf(4096) tor_src_dp;
    dataport Buf(4096) tor_dest_dp;
    emits Ready tor_ready;
    consumes Done tor_done;
    has mutex cross_vm_event_mutex;
    VM_INIT_DEF()
}

component Init1 {
    dataport Buf(4096) tor_src_dp;
    dataport Buf(4096) tor_dest_dp;
    consumes Ready tor_ready;
    emits Done tor_done;
    has mutex cross_vm_event_mutex;
    VM_INIT_DEF()
}

assembly {
    composition {
        VM_COMPOSITION_DEF()
        VM_PER_VM_COMP_DEF(0)
        VM_PER_VM_COMP_DEF(1)

        connection seL4SharedDataWithCaps tor_conn_src(from vm0.tor_src_dp,
                                                        to vm1.tor_src_dp);
        connection seL4SharedDataWithCaps tor_conn_dest(from vm1.tor_dest_dp,
                                                         to vm0.tor_dest_dp);
        connection seL4Notification tor_ready_conn(from vm0.tor_ready,
                                                   to vm1.tor_ready);
        connection seL4Notification tor_done_conn(from vm1.tor_done,
                                                  to vm0.tor_done);
    }

    configuration {
        VM_CONFIGURATION_DEF()
        VM_PER_VM_CONFIG_DEF(0)
        vm0.simple_untyped23_pool = 40;
        vm0.simple_untyped22_pool = 1;
        vm0.heap_size = 0x10000;
        vm0.guest_ram_mb = 128;
        vm0.kernel_cmdline = VM_GUEST_CMDLINE;
        vm0.kernel_image = "bzimage";
        vm0.kernel_relocs = "bzimage";
        vm0.initrd_image = "rootfs.cpio";
        vm0.tor_src_dp_id = 1;
        vm0.tor_src_dp_size = 4096;
        vm0.tor_dest_dp_id = 2;
        vm0.tor_dest_dp_size = 4096;
        vm0.iospace_domain = 0x0f;
        vm0.pci_devices_iospace = 1;

        VM_PER_VM_CONFIG_DEF(1)
        vm1.simple_untyped23_pool = 40;
        vm1.simple_untyped22_pool = 1;
        vm1.heap_size = 0x10000;
        vm1.guest_ram_mb = 256;
        vm1.kernel_cmdline = VM_GUEST_CMDLINE;
        vm1.kernel_image = "bzimage";
        vm1.kernel_relocs = "bzimage";
        vm1.initrd_image = "rootfs_vm1.cpio";
        vm1.tor_src_dp_id = 1;
        vm1.tor_src_dp_size = 4096;
        vm1.tor_dest_dp_id = 2;
        vm1.tor_dest_dp_size = 4096;
        vm1.iospace_domain = 0x10;
        vm1.pci_devices_iospace = 2;

        /* e1000 NIC passthrough to vm1 for Tor network access.
         * QEMU: -device e1000,netdev=net0 -netdev user,id=net0
         * QEMU assigns: Bus 0, Dev 3, Fun 0, IRQ 11
         * e1000 BAR layout: BAR0 MMIO 128KB, BAR1 I/O 0xc000-0xc03f (0x40),
         * BAR2 Flash MMIO, BAR3 unsupported.
         * I/O-port-only mode: DUMMY memory entry at 0xa0004000 (4KB).
         * 0xa0004000 sits in the cross_vm dataport MMIO range (tor_src_dp
         * @ 0xa0001000, tor_dest_dp @ 0xa0003000) that seL4 already has
         * untypeds for. The capdl template (seL4VMPCIDevices.template.c)
         * iterates device['memory'] and allocates frame caps; an empty array
         * emits a broken cap reference that prevents PCI config-space
         * passthrough. The dummy satisfies the template so the VMM registers
         * the e1000 BDF (0:3:0) for 0xCF8/0xCFC passthrough. The guest then
         * discovers the e1000 via PCI config space and uses I/O ports
         * (0xc000-0xc040) for register access — the dummy frame is never
         * touched by the driver.
         */
        vm1.pci_devices = [
            {
                "name":"Ethernet0",
                "bus":0, "dev":3, "fun":0,
                "irq":"Ethernet0",
                "memory":[
                    {"paddr":0xa0004000, "size":0x1000, "page_bits":12}
                ],
            },
        ];
        vm1.vm_ioports = [
            {"start":0xc000, "end":0xc040, "pci_device":3, "name":"Ethernet0"},
        ];
        vm1.vm_irqs = [
            {"name":"Ethernet0", "ioapic":0, "source":11, "level_trig":1, "active_low":1, "dest":11},
        ];
    }
}
