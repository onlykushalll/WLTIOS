# WLT-Net Makefile
# Builds the network manager daemon and CLI (`wltnet`).
#
# Spec: docs/specs/wlt-net.md
# ADR:  docs/adr/03-tor-in-second-vm.md, docs/adr/07-custom-init.md

CC      = gcc
CFLAGS  = -Wall -Wextra -Werror -std=gnu11 -O2 -Iinclude \
          -D_GNU_SOURCE
LDFLAGS =

SRCS = net.c config.c wifi.c ethernet.c tor_proxy.c mac.c kill_switch.c
OBJS = $(SRCS:.c=.o)

TARGET = wltnet

.PHONY: all clean install test

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(LDFLAGS) -o $@ $(OBJS)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# Header dependencies
net.o:         include/net.h include/wifi.h include/tor_proxy.h include/mac.h
config.o:      include/net.h
wifi.o:        include/net.h include/wifi.h include/mac.h
ethernet.o:    include/net.h
tor_proxy.o:   include/net.h include/tor_proxy.h
mac.o:         include/net.h include/mac.h
kill_switch.o: include/net.h include/tor_proxy.h

# Quick syntax-check without linking (useful in CI sandboxes that lack
# the kernel headers used by the wpa_supplicant / netlink code paths).
check-syntax:
	@for f in $(SRCS); do \
		$(CC) $(CFLAGS) -fsyntax-only $$f || exit 1; \
	done

# Run the in-tree unit tests (assumes tests/userspace/wlt-net_*_test.c
# exists — generated by the test-agent).
test: $(TARGET)
	@cd ../../.. && $(MAKE) tests/userspace/wlt-net_test

clean:
	rm -f $(OBJS) $(TARGET)

install: $(TARGET)
	install -D $(TARGET) $(DESTDIR)/usr/bin/wltnet
	install -D -m 0644 ../../../config/wlt-net.conf \
		$(DESTDIR)/etc/wlt/network.conf
	install -D -m 0644 ../../../config/services/wlt-net.service \
		$(DESTDIR)/etc/wlt/services/wlt-net.service
