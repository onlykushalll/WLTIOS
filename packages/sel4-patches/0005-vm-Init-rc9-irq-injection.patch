+static seL4_CPtr rc9_irq_handlers[16];
+
+/* RC9 fix v5: called by the vmm interrupt layer AFTER a vector was actually
+ * delivered to the guest (directly or via the interrupt window). Re-Acking
+ * here (not at inject time) makes the level-triggered host line self-clocking:
+ * each new host-IRQ sample requires the guest to have consumed the previous
+ * one, so the guest can never be starved by an asserted level line. */
+void vm_rc9_reack_vector(int vector)
+{
+    int i = vector - 0x30;
+    if (i >= 0 && i < 16 && rc9_irq_handlers[i]) {
+        seL4_IRQHandler_Ack(rc9_irq_handlers[i]);
+    }
+}
