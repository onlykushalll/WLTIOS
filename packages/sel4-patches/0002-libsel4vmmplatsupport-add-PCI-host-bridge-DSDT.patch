@@ -23,6 +23,32 @@ Author: W.A. */
 #include <sel4vmmplatsupport/guest_memory_util.h>
 #include <sel4vmmplatsupport/arch/acpi.h>
 
+/* WLTIOS DSDT AML body (138 bytes), compiled by iasl from wltios_v2.dsl —
+ * Scope(\_SB){Device(PCI0){_HID=PNP0A03, _BBN=0, _SEG=0,
+ * _CRS=IO 0xCF8-0xCFF (config) + IO 0xC000-0xCFFF (pcnet BAR0 window) +
+ * MEM 0xA0000000-0xDFFFFFFF (PCI MMIO), _PRT=[[00:01.0 INTA -> GSI 11]]}}.
+ * HISTORY: the original array carried a 36-byte DSDT table header that
+ * acpi_fill_table_head() wrapped in a SECOND header, so the kernel parsed
+ * the ASCII "DSDT" magic as AML opcodes and PCI0 never materialised (no
+ * root bridge, no bus scan, pcnet32 never bound). Fixed 2026-09-18 by
+ * embedding the bare AML body; _PRT added the same day to give the pcnet
+ * INT A a GSI ("PCI INT A: no GSI" was the last remaining probe failure). */
+const unsigned char wltios_dsdt_aml[138] = {
+    0x10, 0x49, 0x08, 0x5f, 0x53, 0x42, 0x5f, 0x5b, 0x82, 0x41, 0x08, 0x50,
+    0x43, 0x49, 0x30, 0x08, 0x5f, 0x48, 0x49, 0x44, 0x0c, 0x41, 0xd0, 0x0a,
+    0x03, 0x08, 0x5f, 0x42, 0x42, 0x4e, 0x00, 0x08, 0x5f, 0x53, 0x45, 0x47,
+    0x00, 0x08, 0x52, 0x45, 0x53, 0x30, 0x11, 0x3f, 0x0a, 0x3c, 0x88, 0x0d,
+    0x00, 0x01, 0x0c, 0x03, 0x00, 0x00, 0xf8, 0x0c, 0xff, 0x0c, 0x00, 0x00,
+    0x08, 0x00, 0x88, 0x0d, 0x00, 0x01, 0x0c, 0x03, 0x00, 0x00, 0x00, 0xc0,
+    0xff, 0xcf, 0x00, 0x00, 0x00, 0x10, 0x87, 0x17, 0x00, 0x00, 0x0c, 0x01,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xa0, 0xff, 0xff, 0xff, 0xdf,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x40, 0x79, 0x00, 0x14, 0x0b,
+    0x5f, 0x43, 0x52, 0x53, 0x00, 0xa4, 0x52, 0x45, 0x53, 0x30, 0x08, 0x5f,
+    0x50, 0x52, 0x54, 0x12, 0x0e, 0x01, 0x12, 0x0b, 0x04, 0x0c, 0xff, 0xff,
+    0x01, 0x00, 0x00, 0x00, 0x0a, 0x0b
+};
+
+
 #define HPET_DEFAULT_PADDR 0xfed00000
 #define HPET_DEFAULT_TBID  0x8086a201
 
@@ -221,12 +247,13 @@ int make_guest_acpi_tables(vm_t *vm)
     num_tables++;
 #endif
 
-    // DSDT
-    int dsdt_size = sizeof(acpi_dsdt_t);
+    // DSDT — WLTIOS: includes PCI host bridge AML so kernel scans PCI bus
+    int dsdt_size = sizeof(acpi_dsdt_t) + sizeof(wltios_dsdt_aml);
     acpi_dsdt_t *dsdt = calloc(1, dsdt_size);
     assert(NULL != dsdt);
 
-    acpi_fill_table_head(&dsdt->header, "DSDT", 1);
+    acpi_fill_table_head(&dsdt->header, "DSDT", 2);
+    memcpy((char *)dsdt + sizeof(acpi_dsdt_t), wltios_dsdt_aml, sizeof(wltios_dsdt_aml));
 
     dsdt->header.length = dsdt_size;
     dsdt->header.checksum = acpi_calc_checksum((char *)dsdt, dsdt_size);
