+/* RC9 fix: direct external-interrupt injection at a raw vector.
+ * Bypasses the emulated LAPIC IRR/ISR/PPR machinery entirely -- the guest
+ * is an ioapic-mode OS: ISA IRQ n arrives as vector 0x30+n (programmed by
+ * the guest itself into the passthrough host ioapic). The emulated LAPIC's
+ * ISR never clears (the guest EOIs the real VTX APIC, not the emulation),
+ * so same-class vectors were priority-blocked forever. If we cannot inject
+ * right now, arm the interrupt window; the caller's host-IRQ re-Ack loop
+ * retries within ~ms while the device line is held. */
+void vm_apic_inject_external_vector(vm_vcpu_t *vcpu, int vector)
+{
+    if (can_inject(vcpu)) {
+        inject_irq(vcpu, vector);
+        vm_rc9_reack_vector(vector);
+    } else {
+        /* guest not injectable now (e.g. IF=0): queue and deliver at the
+         * next interrupt window; the caller's re-ack loop will re-sample
+         * the host line, so a queued vector is never lost. */
+        rc9_pending_vector = vector;
+        wait_for_guest_ready(vcpu);
+    }
+}
