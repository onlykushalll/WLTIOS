# WLTIOS custom kernel configuration
# Built from Linux 5.10.218 source with e1000 + virtio_net built-in
# (not as modules) so the initramfs doesn't need any .ko files.
#
# This config is used by scripts/build-custom-kernel.sh to produce
# a bzImage that has all required drivers compiled in.

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Initramfs + early userspace
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Devtmpfs (auto /dev)
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Filesystems
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# Serial console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y

# VT + framebuffer
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# DRM (for wlroots DRM backend / virtio-vga)
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y

# Input
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y

# Networking — all built-in (=y, not =m)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_SYN_COOKIES=y
CONFIG_TCP=y
CONFIG_UDP=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# Network drivers — built-in
CONFIG_PCI=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_8139TOO=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y

# Block devices
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y

# ELF binaries
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Crypto (for TLS, etc.)
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_SHA256=y

# Misc required
CONFIG_PRINTK=y
CONFIG_FUTEX=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_INOTIFY_USER=y
CONFIG_FHANDLE=y

# Use frame pointer unwinder (avoids libelf-dev dependency for objtool)
CONFIG_UNWINDER_FRAME_POINTER=y
# CONFIG_UNWINDER_ORC is not set
# CONFIG_STACK_VALIDATION is not set
