/*
 * minimal_tor_pd_vm1.camkes — Two Linux Guest VMs (vm0 + vm1) with IPC
 *
 * This implements ADR-09: TorPD as a real second Linux guest VM (vm1),
 * not a bare component. vm0 is the main Linux guest (GUI, apps); vm1 is
 * the TorPD Linux guest (will run Tor in Phase 2). They communicate
 * via shared memory + notifications — the VM-to-VM IPC pattern that
 * ADR-09 flagged as the unproven risk.
 *
 * Phase 1: ping/pong IPC proof (this file).
 * Phase 2: Tor running inside vm1 (follow-up).
 */
import <VM/vm.camkes>;

#include <configurations/vm.h>

#define VM_GUEST_CMDLINE "earlyprintk=ttyS0,115200 console=ttyS0,115200 i8042.nokbd=y i8042.nomux=y \
i8042.noaux=y io_delay=udelay noisapnp pci=nomsi debug root=/dev/mem"

component Init0 {
    /* vm0's side of the vm0↔vm1 IPC */
    dataport Buf(4096) tor_src_dp;
    dataport Buf(4096) tor_dest_dp;
    emits Ready tor_ready;
    consumes Done tor_done;
    VM_INIT_DEF()
}

component Init1 {
    /* vm1's side of the vm0↔vm1 IPC */
    dataport Buf(4096) tor_src_dp;
    dataport Buf(4096) tor_dest_dp;
    consumes Ready tor_ready;
    emits Done tor_done;
    VM_INIT_DEF()
}

assembly {
    composition {
        VM_COMPOSITION_DEF()
        VM_PER_VM_COMP_DEF(0)
        VM_PER_VM_COMP_DEF(1)

        /* Shared memory connections between vm0 and vm1 (VM-to-VM IPC) */
        connection seL4SharedDataWithCaps tor_conn_src(from vm0.tor_src_dp,
                                                        to vm1.tor_src_dp);
        connection seL4SharedDataWithCaps tor_conn_dest(from vm1.tor_dest_dp,
                                                         to vm0.tor_dest_dp);

        /* Notification connections for synchronization */
        connection seL4Notification tor_ready_conn(from vm0.tor_ready,
                                                   to vm1.tor_ready);
        connection seL4Notification tor_done_conn(from vm1.tor_done,
                                                  to vm0.tor_done);
    }

    configuration {
        VM_CONFIGURATION_DEF()
        VM_PER_VM_CONFIG_DEF(0)
        VM_PER_VM_CONFIG_DEF(1)

        vm0.simple_untyped23_pool = 20;
        vm1.simple_untyped23_pool = 20;

        vm0.guest_ram = 0x10000000;  /* 256MB for vm0 */
        vm1.guest_ram = 0x10000000;  /* 256MB for vm1 */

        vm0.guest_ram_mb = 128;
        vm0.kernel_cmdline = VM_GUEST_CMDLINE;
        vm0.kernel_image = "bzimage";
        vm0.kernel_relocs = "bzimage";
        vm0.initrd_image = "rootfs.cpio";

        vm1.guest_ram_mb = 128;
        vm1.kernel_cmdline = VM_GUEST_CMDLINE;
        vm1.kernel_image = "bzimage_vm1";
        vm1.kernel_relocs = "bzimage_vm1";
        vm1.initrd_image = "rootfs_vm1.cpio";
    }
}
